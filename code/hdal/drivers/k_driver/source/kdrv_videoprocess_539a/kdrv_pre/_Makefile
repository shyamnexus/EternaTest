MODULE_NAME = kdrv_ime
# DIRs
VOS_DRIVER_DIR = $(NVT_VOS_DIR)/drivers
KDRV_DIR = $(NVT_HDAL_DIR)/drivers/k_driver
CURR_DRIVER_DIR = $(KDRV_DIR)
# INCs
VOS_INC_PATH = $(VOS_DRIVER_DIR)/include
KDRV_INC_PATH = $(KDRV_DIR)/include
KDRV_SRC_INC_PATH = $(KDRV_DIR)/source/include
CURR_DRIVER_INC_PATH = $(CURR_DRIVER_DIR)/include
# INC FLAGs
EXTRA_INCLUDE += \
	-I$(VOS_INC_PATH) \
	-I$(KDRV_INC_PATH) \
	-I$(CURR_DRIVER_INC_PATH) \
	-I$(KDRV_SRC_INC_PATH) \

EXTRA_INCLUDE += -I$(KDRV_INC_PATH)/rtos_$(SDK_CODENAME)

###############################################################################
# Linux Makefile                                                              #
###############################################################################
ifeq ($(NVT_PRJCFG_CFG),Linux)
EXTRA_CFLAGS += -DDEBUG

SRC += \
	ime_main.c \
	ime_proc.c \
	ime_drv.c \
	ime_api.c \
	ime_platform.c \
	ime_3dnr_base.c \
	ime_compression_base.c \
	ime_control_base.c \
	ime_function_base.c \
	ime_in_path_base.c \
	ime_int_public.c \
	ime_osd_base.c \
	ime_lca_base.c \
	ime_adas_base.c \
	ime_dbcs_base.c \
	ime_out_path1_base.c \
	ime_out_path2_base.c \
	ime_out_path3_base.c \
	ime_out_path4_base.c \
	ime_pm_base.c \
	ime_int.c \
	ime.c \
	kdrv_ime_api.c \
	kdrv_ime_config.c \
	ime_kit.c

###############################################################################
# rtos Makefile                                                               #
###############################################################################
else ifeq ($(NVT_PRJCFG_CFG),rtos)
EXTRA_CFLAGS += \
	-DDEBUG \
	-I$(CURDIR)/include \


SRC += \
	ime_platform.c \
	ime_3dnr_base.c \
	ime_compression_base.c \
	ime_control_base.c \
	ime_function_base.c \
	ime_in_path_base.c \
	ime_int_public.c \
	ime_osd_base.c \
	ime_lca_base.c \
	ime_adas_base.c \
	ime_dbcs_base.c \
	ime_out_path1_base.c \
	ime_out_path2_base.c \
	ime_out_path3_base.c \
	ime_out_path4_base.c \
	ime_pm_base.c \
	ime_int.c \
	ime.c \
	kdrv_ime_api.c \
	kdrv_ime_config.c \
	ime_kit.c \
	ime_dbg_cmd.c \

endif

include $(NVT_HDAL_DIR)/driver.mk
