MODULE_NAME = kdrv_ise
# DIRs
VOS_DRIVER_DIR = $(NVT_VOS_DIR)/drivers
KDRV_DIR = $(NVT_HDAL_DIR)/drivers/k_driver
CURR_DRIVER_DIR = $(KDRV_DIR)
# INCs
VOS_INC_PATH = $(VOS_DRIVER_DIR)/include
KDRV_INC_PATH = $(KDRV_DIR)/include
KDRV_SRC_INC_PATH = $(KDRV_DIR)/source/include
CURR_DRIVER_INC_PATH = $(CURR_DRIVER_DIR)/include
# INC FLAGs
EXTRA_INCLUDE += \
	-I$(VOS_INC_PATH) \
	-I$(KDRV_INC_PATH) \
	-I$(CURR_DRIVER_INC_PATH) \
	-I$(KDRV_SRC_INC_PATH) \

EXTRA_INCLUDE += -I$(KDRV_INC_PATH)/rtos_$(SDK_CODENAME)

###############################################################################
# Linux Makefile                                                              #
###############################################################################
ifeq ($(NVT_PRJCFG_CFG),Linux)
EXTRA_CFLAGS += -DDEBUG

SRC += \
	ise_main.c \
	ise_proc.c \
	ise_drv.c \
	ise_api.c \
	ise_platform.c \
	ise_base.c \
	ise_int.c \
	ise_linked_list.c \
	ise.c \
	kdrv_ise_id.c \
	kdrv_ise_api.c \
	ise_kit.c \

###############################################################################
# rtos Makefile                                                               #
###############################################################################
else ifeq ($(NVT_PRJCFG_CFG),rtos)
EXTRA_CFLAGS += \
	-DDEBUG \
	-I$(CURDIR)/include \


SRC += \
	ise_platform.c \
	ise_base.c \
	ise_int.c \
	ise_linked_list.c \
	ise.c \
	kdrv_ise_id.c \
	kdrv_ise_api.c \
	ise_kit.c \
	ise_dbg_cmd.c \

endif

include $(NVT_HDAL_DIR)/driver.mk
