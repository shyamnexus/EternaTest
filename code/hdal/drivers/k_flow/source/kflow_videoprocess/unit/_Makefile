MODULE_NAME = kflow_videoproc
# DIRs
VOS_DRIVER_DIR = $(NVT_VOS_DIR)/drivers
KDRV_DIR = $(NVT_HDAL_DIR)/drivers/k_driver
KFLOW_DIR = $(NVT_HDAL_DIR)/drivers/k_flow
CURR_DRIVER_DIR = $(KFLOW_DIR)
# INCs
VOS_INC_PATH = $(VOS_DRIVER_DIR)/include
KDRV_INC_PATH = $(KDRV_DIR)/include
KFLOW_INC_PATH = $(KFLOW_DIR)/include
CURR_DRIVER_INC_PATH = $(CURR_DRIVER_DIR)/include
# INC FLAGs
EXTRA_INCLUDE += \
	-I$(VOS_INC_PATH) \
	-I$(KDRV_INC_PATH) \
	-I$(KFLOW_INC_PATH) \
	-I$(CURR_DRIVER_INC_PATH) \

###############################################################################
# Linux Makefile                                                              #
###############################################################################
ifeq ($(NVT_PRJCFG_CFG),Linux)
EXTRA_CFLAGS += \
	-Wno-missing-braces \
	-DDEBUG \


$(MODULE_NAME)-src := \
	linux/isf_vdoprc_main.c \
	linux/isf_vdoprc_proc.c \
	linux/isf_vdoprc_drv.c \
	isf_vdoprc_api.c \
	isf_vdoprc_id.c \
	isf_vdoprc.c \
	isf_vdoprc_input.c \
	isf_vdoprc_input_mask.c \
	isf_vdoprc_input_osd.c \
	isf_vdoprc_process.c \
	isf_vdoprc_output.c \
	isf_vdoprc_output_ext.c \
	isf_vdoprc_output_ext_tsk.c \
	isf_vdoprc_output_mask.c \
	isf_vdoprc_output_osd.c \
	isf_vdoprc_pull.c \
	isf_vdoprc_debug.c \
	isf_vdoprc0.c \
	isf_vdoprc1.c \
	isf_vdoprc2.c \
	isf_vdoprc3.c \
	isf_vdoprc4.c \
	isf_vdoprc5.c \
	isf_vdoprc6.c \
	isf_vdoprc7.c \
	isf_vdoprc8.c \
	isf_vdoprc9.c \
	isf_vdoprc10.c \
	isf_vdoprc11.c \
	isf_vdoprc12.c \
	isf_vdoprc13.c \
	isf_vdoprc14.c \
	isf_vdoprc15.c \
	isf_vdoprc_verinfo.c

###############################################################################
# rtos Makefile                                                               #
###############################################################################
else ifeq ($(NVT_PRJCFG_CFG),rtos)
EXTRA_CFLAGS += \
	-DDEBUG \
	-Wno-format \


