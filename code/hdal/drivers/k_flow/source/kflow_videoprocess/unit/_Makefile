	rtos/isf_vdoprc_drv.c \
	rtos/isf_vdoprc_proc.c \
	isf_vdoprc_api.c \
	isf_vdoprc_id.c \
	isf_vdoprc.c \
	isf_vdoprc_input.c \
	isf_vdoprc_input_mask.c \
	isf_vdoprc_input_osd.c \
	isf_vdoprc_process.c \
	isf_vdoprc_output.c \
