# Makefile for Audio Features Test & Live Demo
# Tests all audio processing features: Volume, Gain, ALC, AGC, Filter, Noise Gate

MODULE_NAME = audio_live_demo

# DIRs
VOS_DRIVER_DIR = $(NVT_VOS_DIR)/drivers
HDAL_SAMPLE_DIR = $(NVT_HDAL_DIR)/samples
OUTPUT_DIR = $(HDAL_SAMPLE_DIR)/output
VENDOR_INC_PATH = $(NVT_HDAL_DIR)/vendor/media/include
VENDOR_LIB_PATH = $(NVT_HDAL_DIR)/vendor/output

# Userspace audio library paths  
AUDIO_LIB_INC = $(shell dirname $(NVT_PRJCFG_MODEL_CFG))/../../../code/lib/include
AUDIO_LIB_PATH = $(shell dirname $(NVT_PRJCFG_MODEL_CFG))/../../../code/lib/output

# INCs
VOS_INC_PATH = $(VOS_DRIVER_DIR)/include
HDAL_INC_PATH = $(NVT_HDAL_DIR)/include
HDAL_LIB_PATH = $(NVT_HDAL_DIR)/output

# INC FLAGs
EXTRA_INCLUDE += \
	-I$(HDAL_INC_PATH) \
	-I$(VOS_INC_PATH) \
	-I$(VENDOR_INC_PATH) \
	-I$(AUDIO_LIB_INC)

###############################################################################
# Linux Makefile                                                              #
###############################################################################
ifeq ($(NVT_PRJCFG_CFG),Linux)
EXTRA_CFLAGS += $(NVT_ASAN) -D__LINUX
EXTRA_LDFLAGS = $(NVT_ASAN) -L$(HDAL_LIB_PATH) -L$(VENDOR_LIB_PATH) -L$(AUDIO_LIB_PATH) \
	-lhdal -lvendor_media -lagc -laudfilt -laec -lpthread -lm
SRC += audio_live_demo.c

###############################################################################
# rtos Makefile                                                               #
###############################################################################
else ifeq ($(NVT_PRJCFG_CFG),rtos)

# DIRs
RTOS_KERNEL_DIR = $(KERNELDIR)/lib/FreeRTOS
RTOS_LIB_DIR = $(KERNELDIR)/lib
RTOS_CURR_DEMO_DIR = $(KERNELDIR)/demos/novatek/$(SDK_CODENAME)
RTOS_POSIX_DIR = $(KERNELDIR)/lib/FreeRTOS-Plus-POSIX
RTOS_POSIX_SRC_DIR = $(RTOS_POSIX_DIR)/source

#INCs for EXTRA_CFLAGS
EXTRA_INCLUDE += \
	-I$(RTOS_LIB_DIR) \
	-I$(RTOS_KERNEL_DIR)/portable/GCC/ARM_CA9 \
	-I$(RTOS_KERNEL_DIR)/include \
	-I$(RTOS_KERNEL_DIR)/include/private \
	-I$(RTOS_CURR_DEMO_DIR)/include \
	-I$(RTOS_POSIX_DIR)/include \
	-I$(RTOS_POSIX_DIR)/include/portable/novatek \
	-I$(LIBRARY_DIR)/include

EXTRA_CFLAGS += -Wno-format
SRC += audio_features_test.c

endif

include $(NVT_HDAL_DIR)/executable.mk

# Debug build
debug: CFLAGS += -g -DDEBUG
debug: clean all

# Help
help:
	@echo "╔══════════════════════════════════════════════════════════════════╗"
	@echo "║           Audio Features Test - Build Instructions               ║"
	@echo "╚══════════════════════════════════════════════════════════════════╝"
	@echo ""
	@echo "Build:"
	@echo "  make                Build the test application"
	@echo "  make clean          Remove build artifacts"
	@echo "  make debug          Build with debug symbols"
	@echo ""
	@echo "Usage:"
	@echo "  ./audio_features_test [options]"
	@echo ""
	@echo "Options:"
	@echo "  --test <mode>       all, volume, gain, alc, agc, record"
	@echo "  --volume <0-200>    Capture volume (100=unity)"
	@echo "  --duration <sec>    Recording duration"
	@echo "  --rate <hz>         Sample rate (8000 for AEC, 48000 default)"
	@echo "  --output <path>     Output directory"
	@echo "  --help              Show help"
	@echo ""
	@echo "Features Tested:"
	@echo "  ✓ Volume Control (HD_AUDIOCAP_PARAM_VOLUME)"
	@echo "  ✓ Gain Level (VENDOR_AUDIOCAP_ITEM_GAIN_LEVEL)"
	@echo "  ✓ ALC Enable (VENDOR_AUDIOCAP_ITEM_ALC_ENABLE)"
	@echo "  ✓ ALC Config (VENDOR_AUDIOCAP_ITEM_ALC_CONFIG)"
	@echo "  ✓ Loopback (VENDOR_AUDIOCAP_ITEM_LOOPBACK_CONFIG)"
	@echo "  ○ Default Setting (requires OUT path)"
	@echo "  ○ AGC (requires AUDCAP_LIB_AGC=ENABLE)"
	@echo "  ○ Noise Gate (requires OUT path)"
	@echo ""

.PHONY: help debug
