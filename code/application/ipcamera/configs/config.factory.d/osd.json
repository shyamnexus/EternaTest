            "region0": {
                "enabled": false,
                "x1": 800,
                "y1": 400,
                "x2": 1120,
                "y2": 680
            },
            "region1": {
                "enabled": false,
                "x1": 0,
                "y1": 0,
                "x2": 100,
                "y2": 100
            },
            "region2": {
                "enabled": false,
                "x1": 0,
                "y1": 0,
                "x2": 100,
                "y2": 100
            },
            "region3": {
                "enabled": false,
                "x1": 0,
