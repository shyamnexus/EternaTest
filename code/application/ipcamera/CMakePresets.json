{
  "version": 3,
  "configurePresets": [
    {
      "name": "aarch64-ca53",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "description": "ARM CA53 cross-compile (NVT SDK default)",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/aarch64-ca53.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "BUILD_TESTING": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "aarch64-ca53-dev",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "description": "ARM CA53 cross-compile for IDE/development (allows missing deps)",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/aarch64-ca53.cmake",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "BUILD_TESTING": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "IPCAMERA_ALLOW_MISSING_DEPS": "ON"
      }
    },
    {
      "name": "aarch64-gnu",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "description": "ARM aarch64 cross-compile (generic aarch64-linux-gnu toolchain)",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "BUILD_TESTING": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "description": "Ubuntu x64 native build (system compiler)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "IPCAMERA_USE_SYSTEM_COMPILER": "ON",
        "CMAKE_C_COMPILER": "/usr/bin/gcc",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ]
}
