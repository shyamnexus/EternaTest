			clocks = <&fix80m>, <&pll8>, <&fix480m>;
			current_rate = <1400000000>;
			parent_idx = <1>;
			mux_reg_offset = <CG_SYS_CLK_RATE_REG0_OFFSET>;
			mux_bit_idx = <0>;
			mux_bit_width = <2>;
			div_reg_offset = <0>;
			div_bit_idx = <0>;
