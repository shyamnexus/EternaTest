/*
 * Novatek Ltd. BSP part of dts
 */

/ {
	nvt-clk {
		/* Fixed Clock */
		reserved: reserved {
			#clock-cells = <0>;
			compatible = "nvt,nvt-fixed-clock";
			clock-frequency = <0>;
			clock-output-names = "reserved";
		};

		PAUTOGATING: PAUTOGATING {
			#clock-cells = <0>;
			compatible = "nvt,nvt-fixed-clock";
			clock-frequency = <0>;
			clock-output-names = "PAUTOGATING";
