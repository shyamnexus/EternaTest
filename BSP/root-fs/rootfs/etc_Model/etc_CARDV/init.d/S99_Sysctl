[ -f /etc/sysctl.conf ] && sysctl -p >&-
# incrase net tx window size to send 4K@P60,16Mb/s without EAGAIN
echo 1572864 > /proc/sys/net/core/wmem_max
# following proc command is only for NovaTek EVB
# please mark it on customer's device

# Note: printk will affect gyro data receiving, disable printk if enable gyro
if [ "${GYRO}" != "GYRO_NONE" ]; then
echo 0 0 0 0 > /proc/sys/kernel/printk
else
echo 7 4 1 7 > /proc/sys/kernel/printk
fi

#temporary force flush for ui
echo 1 > /proc/kflow_gfx/default_flush

cardv &
